# Sao chép file này thành .env rồi điền thông tin thật
# Lấy API key: đăng nhập https://pos.pancake.vn -> Cấu hình (Settings) -> Ứng dụng khác / API -> Tạo API key
PANCAKE_API_KEY=dien_api_key_cua_ban_vao_day

# ID cửa hàng (shop). Nếu chưa biết, cứ để trống rồi chạy: python test_connection.py
# Script sẽ liệt kê tất cả shop kèm ID để bạn chọn.
PANCAKE_SHOP_ID=

# ---- Google Sheets (tùy chọn, dùng với cờ --gsheet) ----
# ID Google Sheet đích. Để trống: lần chạy --gsheet đầu tiên sẽ tự tạo sheet mới
# và tự điền ID vào đây.
GOOGLE_SHEET_ID=
# Email được chia sẻ quyền chỉnh sửa khi tự tạo sheet mới (email Google của bạn)
GOOGLE_SHARE_EMAIL=

# ID trang tính RIÊNG cho bộ phận CSKH (trang tính GOOGLE_SHEET_ID ở trên dành cho Sale).
# Tạo 1 Google Sheet mới, chia sẻ quyền Editor cho email service account
# (client_email trong service_account.json) rồi dán ID vào đây
# (ID = đoạn giữa /d/ và /edit trên URL của trang tính).
GOOGLE_SHEET_ID_CSKH=

# Trang tính "Lịch trực ngày nghỉ" (đăng ký làm Chủ nhật; CN không đăng ký -> thưởng = 0).
# Để trống sẽ dùng ID mặc định trong config.py.
GOOGLE_SHEET_ID_LICH_TRUC=
